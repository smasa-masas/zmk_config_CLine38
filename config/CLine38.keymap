#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <1 0>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <8 9>;
        };

        layer4 {
            bindings = <&mo 4>;
            key-positions = <34 35>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W             &kp E     &kp R             &kp T                                           &kp Y      &kp U  &kp I      &kp O    &kp P
&kp A             &kp S             &kp D     &kp F             &kp G                                           &kp H      &kp J  &kp K      &kp L    &kp MINUS
&mt LEFT_SHIFT Z  &kp X             &kp C     &kp V             &kp B                                           &kp N      &kp M  &kp COMMA  &kp DOT  &mt LEFT_SHIFT LS(INT_RO)
                  &kp LEFT_CONTROL  &kp LALT  &lt 2 LANGUAGE_2  &lt 1 SPACE  &lt 2 LANGUAGE_1    &kp BACKSPACE  &lt 3 RET                    &mo 3
            >;
        };

        layer_1 {
            bindings = <
&kp F4  &kp LS(N2)  &kp LS(N6)  &kp LS(N8)  &kp LS(N9)                    &kp KP_PLUS      &kp N7  &kp N8  &kp N9      &kp KP_MINUS
&trans  &trans      &trans      &trans      &kp MINUS                     &kp KP_MULTIPLY  &kp N4  &kp N5  &kp N6      &kp KP_SLASH
&trans  &trans      &trans      &trans      &trans                        &kp N0           &kp N1  &kp N2  &kp N3      &kp DOT
        &trans      &trans      &trans      &trans      &trans    &trans  &trans                           &kp DOLLAR
            >;
        };

        MOUSE {
            bindings = <
&trans  &kp F7  &kp F8  &kp F9  &kp F10                    &kp LC(Y)  &kp LC(C)       &mkp MB2        &mkp MB2         &mo 3
&trans  &kp F4  &kp F5  &kp F6  &kp F11                    &kp LC(Z)  &mkp MB1        &mkp MB1        &mkp MB2         &kp LC(F)
&trans  &kp F1  &kp F2  &kp F3  &kp F12                    &kp LC(A)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp HOME
        &trans  &trans  &trans  &trans   &trans    &trans  &trans                                     &kp ESC
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                            &kp LA(LS(MINUS))  &kp LC(PAGE_UP)  &kp UP_ARROW    &kp LC(PAGE_DOWN)  &kp LS(LG(S))
&trans  &trans  &trans  &trans  &trans                            &kp LA(SEMI)       &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW    &kp C_BRIGHTNESS_INC
&trans  &trans  &trans  &trans  &trans                            &trans             &trans           &trans          &trans             &kp C_BRIGHTNESS_DEC
        &trans  &trans  &trans  &trans  &trans    &studio_unlock  &trans                                              &trans
            >;
        };

        layer_4 {
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3                    &trans  &trans  &trans  &trans  &studio_unlock
&bt BT_CLR_ALL  &bt BT_SEL 4  &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans                          &trans  &trans  &trans  &trans  &trans
                &trans        &trans        &trans        &trans        &trans    &trans  &trans                  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans    &trans  &trans                  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans    &trans  &trans                  &trans
            >;
        };
    };
};
